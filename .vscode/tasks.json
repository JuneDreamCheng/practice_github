{
  "inputs": [
    {"id": "email", "type": "pickString", "description": "选择邮箱", "options": ["zjczjc1983@163.com","zjczjc1983@qq.com",]}
  ],
  "tasks": [
    {
      "label": "get git email",
      "type": "shell",
      "command": "git config user.email"
    },
    {
      "label": "set git email",
      "type": "shell",
      "command": "git config user.email ${input:email}"
    },
    {
      "label": "ssh keygen",
      "type": "shell",
      "command": "ssh-keygen -t ed25519 -C ${input:email} -f ~/.ssh/id_ed25519_${input:email}"
    },
    {
      "label": "copy public key",
      "type": "shell",
      "command": "cat ~/.ssh/id_ed25519_${input:email}.pub | clip",
      "options": {"shell": {"executable": "powershell"}}
    },
    {
      "label": "ssh check",
      "type": "shell",
      "command": "ssh -T git@github.com"
    }
  ],
  "version": "2.0.0"
}